# Required by every run: SEC and other agencies want a contact address in the User-Agent.
SEC_CONTACT_EMAIL=you@example.edu

# Added in the second plan.
# GitHub: create a classic or fine-grained personal access token at
# https://github.com/settings/tokens — no scopes are needed for public data,
# it just raises the search rate limit from unauthenticated to 30 req/min.
GITHUB_TOKEN=
# Not needed yet.
# PATENTSVIEW_API_KEY=
