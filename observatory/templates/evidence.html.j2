<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Observatory evidence &middot; {{ week }}</title>
<style>
  :root { --ink: #1d2125; --muted: #6b7580; --rule: #e3e6e9; }
  body { margin: 0; background: #fff; color: var(--ink);
         font: 15px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
  main { max-width: 1080px; margin: 0 auto; padding: 32px 24px 96px; }
  h1 { font-size: 24px; margin: 0 0 4px; }
  h2 { font-size: 16px; margin: 40px 0 10px; padding-bottom: 6px;
       border-bottom: 1px solid var(--rule); }
  .sub { color: var(--muted); font-size: 13px; margin: 0 0 24px; }
  table { border-collapse: collapse; width: 100%; font-size: 14px; }
  th, td { text-align: left; padding: 7px 10px; border-bottom: 1px solid var(--rule);
           vertical-align: top; }
  th { font-size: 12px; text-transform: uppercase; letter-spacing: 0.04em;
       color: var(--muted); font-weight: 600; }
  code { font-size: 12px; color: var(--muted); }
  .empty { color: var(--muted); font-style: italic; }
  .names { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .names li { font-size: 13px; color: var(--muted); border: 1px solid #dde1e6;
              border-radius: 2px; padding: 4px 8px; }
  a { color: #2b5f8a; }
</style>
</head>
<body>
<main>
  <h1>Evidence &middot; {{ quarter }}</h1>
  <p class="sub">Every observation behind this {{ period_noun }}'s counts, and the
     pattern that matched it. {{ start }} to {{ end }}, lexicon v{{ lexicon_version }}.
     Technologies are ordered by how much evidence they carry; those with none are
     listed at the foot.</p>

  {% for group in groups %}
    <h2 id="{{ group.tech_id }}">{{ group.name }} <span class="sub">({{ group.rows|length }})</span></h2>
    {% if group.rows %}
    <table>
      <thead><tr><th>Date</th><th>Source</th><th>Document</th><th>Matched pattern</th></tr></thead>
      <tbody>
      {% for row in group.rows %}
        <tr>
          <td>{{ row.doc_date or '—' }}</td>
          <td>{{ row.source }}</td>
          <td>
            {% if row.url %}<a href="{{ row.url }}">{{ row.title or row.doc_id }}</a>
            {% else %}{{ row.title or row.doc_id }}{% endif %}
            {% if row.entity %}<br><span class="sub">{{ row.entity }}</span>{% endif %}
          </td>
          <td><code>{{ row.matched_pattern }}</code></td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    {% endif %}
  {% else %}
    <p class="empty">No active technologies on the watchlist.</p>
  {% endfor %}
  {% if empty %}
  <h2 id="none">Looked for, not found</h2>
  <p class="sub">{{ empty|length }} technologies produced no documents this
     {{ period_noun }}. They are named because absence is a finding: the system
     looked and found nothing in these sources. Each keeps its anchor, so a link
     from the report is never dead.</p>
  <ul class="names">
    {% for tech in empty %}<li id="{{ tech.tech_id }}">{{ tech.name }}</li>{% endfor %}
  </ul>
  {% endif %}
</main>
</body>
</html>
